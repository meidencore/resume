---
import Layout from "@/layouts/Layout.astro"

import About from "@/components/sections/About.astro"
import Education from "@/components/sections/Education.astro"
import Experience from "@/components/sections/Experience.astro"
import Hero from "@/components/sections/Hero.astro"
import Projects from "@/components/sections/Projects.astro"
import Skills from "@/components/sections/Skills.astro"
import KeyboardManager from "@/components/KeyboardManager.astro"

import * as cv from "@cv_es"
const { name, label } = cv.basics
---

<Layout title={`${name} - ${label}`} basics={cv.basics}>
  <main>
    <Hero basics={cv.basics}/>
    <About title="Sobre mí" basics={cv.basics}/>
    <Experience title="Experiencia Laboral" work={cv.work}/>
    <Education title="Educación" education={cv.education}/>
    <Projects title="Proyectos" bodyText={["Ver", "Ver código del proyecto"]} projects={cv.projects}/>
    <Skills title="Habilidades" skills={cv.skills}/>
  </main>

  <KeyboardManager basics={cv.basics}/>
</Layout>

<style>
  main {
    padding: 4rem;
    margin: auto;
    width: 100%;
  }

  @media (width <= 700px) {
    main {
      padding: 2rem;
    }
  }
</style>

