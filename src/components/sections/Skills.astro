---
import Section from "../Section.astro"
import Docker from "@/icons/Docker.astro"
import Aspnet from "@/icons/NET.astro"
import Csharp from "@/icons/csharp.astro"
import Mssql from "@/icons/microsoftsqlserver.astro"
import RabbitMQ from "@/icons/RabbitMQ.astro"
import Postman from "@/icons/Postman.astro"
import HTML from "@/icons/html.astro"
import CSS from "@/icons/css.astro"
import JavaScript from "@/icons/javascript.astro"
import TypeScript from "@/icons/typescript.astro"
import React from "@/icons/react.astro"
import Node from "@/icons/node.astro"
import MySQL from "@/icons/sql.astro"
import Git from "@/icons/git.astro"
import GitHub from "@/icons/GitHub.astro"
import TailwindCSS from "@/icons/tailwind.astro"
import Next from "@/icons/next.astro"
import { skills } from "@cv"
import Swift from "@/icons/swift.astro"
import SwiftUI from "@/icons/swiftui.astro"
import Kotlin from "@/icons/kotlin.astro"
import Flutter from "@/icons/flutter.astro"
import PostgreSQL from "@/icons/postgresql.astro"
import MongoDB from "@/icons/mongodb.astro"
import Python from "@/icons/python.astro"
import Grafana from "@/icons/grafana.astro"

const SKILLS_ICONS: Record<string, any> = {
  HTML,
  CSS,
  JavaScript,
  TypeScript,
  React,
  Node,
  MySQL,
  Git,
  GitHub,
  Next,
  TailwindCSS,
  Swift,
  SwiftUI,
  Kotlin,
  Flutter,
  PostgreSQL,
  MongoDB,
  Python,
  Docker,
  RabbitMQ,
  Postman,
  Grafana,
  ['C#']: Csharp ,
  ['ASP.NET Core']: Aspnet,
  ['MSSQL Server']: Mssql,
}
---

<Section title="Habilidades">
  <ul>
    {
      skills.map(({ name }) => {
        const iconName = name === "Next.js" ? "Next" : name
        const Icon = SKILLS_ICONS[iconName]

        return (
          <li>
            {Icon && <Icon />} <span>{name}</span>
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  li {
    align-items: center;
    background: #eee;
    border-radius: 6px;
    color: black;
    display: flex;
    font-size: 0.8rem;
    font-weight: 500;
    gap: 4px;
    padding: 0.2rem 0.6rem;
  }
  span {
    padding-top: 0.25rem
  }
</style>
